# Copy to .env.local and fill in. Only PUBLIC values go here (they ship in the app bundle).

# Supabase — hosted prod project, or the local stack printed by `npm run db:start`
EXPO_PUBLIC_SUPABASE_URL=https://ywlzjytbzmkreonnyman.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Public site URL used in auth emails / redirects
EXPO_PUBLIC_SITE_URL=https://projetx.app

# Optional features (set to 1 once configured in Supabase Auth)
EXPO_PUBLIC_AUTH_GOOGLE=0
EXPO_PUBLIC_AUTH_APPLE=0

# Optional: only on Supabase Pro (image transformations)
EXPO_PUBLIC_SUPABASE_IMAGE_TRANSFORMS=0

# Optional: Sentry DSN (public). Source map upload needs SENTRY_ORG/SENTRY_PROJECT/SENTRY_AUTH_TOKEN as EAS secrets.
EXPO_PUBLIC_SENTRY_DSN=

# EAS (set by `eas init`, public)
EAS_PROJECT_ID=
